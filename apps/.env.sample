# Tutor Platform - app-level local environment template
# Prefer the repository root `.env` for normal local development. This file is
# kept for app-level workflows that explicitly load `apps/.env`.
# Never commit a filled-in `.env` file.

# Core cloud resources
COSMOS_ENDPOINT=""
COSMOS_DATABASE="tutor"
COSMOS_KEY=""

# Cosmos containers
COSMOS_ESSAY_TABLE="essays"
COSMOS_RESOURCE_TABLE="resources"
COSMOS_ASSEMBLY_TABLE="assemblies"
COSMOS_QUESTION_TABLE="questions"
COSMOS_ANSWER_TABLE="answers"
COSMOS_GRADER_TABLE="graders"
COSMOS_CONFIGURATION_TABLE="configuration"
COSMOS_STUDENT_TABLE="students"
COSMOS_PROFESSOR_TABLE="professors"
COSMOS_COURSE_TABLE="courses"
COSMOS_CLASS_TABLE="classes"
COSMOS_GROUP_TABLE="groups"
COSMOS_AVATAR_CASE_TABLE="avatar_case"
COSMOS_UPSKILLING_TABLE="upskilling_plans"
COSMOS_LEARNER_RECORD_EVENTS_TABLE="learner_record_events"
COSMOS_INSIGHTS_REPORT_TABLE="insights_reports"
COSMOS_INSIGHTS_FEEDBACK_TABLE="insights_feedback"
COSMOS_INTEGRATION_IDEMPOTENCY_TABLE="integration_idempotency"
COSMOS_INTEGRATION_CONNECTORS_TABLE="integration_connectors"
COSMOS_INTEGRATION_DEAD_LETTERS_TABLE="integration_dead_letters"

# Azure AI Foundry
PROJECT_ENDPOINT=""
MODEL_DEPLOYMENT_NAME="gpt-5-nano"
MODEL_REASONING_DEPLOYMENT="gpt-5"

# Blob Storage
BLOB_CONNECTION_STRING=""
BLOB_CONTAINER_NAME="uploads"

# Avatar speech token brokering
SPEECH_RESOURCE_ID=""
SPEECH_REGION=""
AVATAR_TEMPERATURE=0.6

# Optional essay media/OCR paths
AZURE_VISION_ENDPOINT=""
AZURE_VISION_KEY=""
DOCUMENT_INTELLIGENCE_ENDPOINT=""
DOCUMENT_INTELLIGENCE_KEY=""
DOCUMENT_INTELLIGENCE_MODEL="prebuilt-read"

# Authentication - set false for local testing without JWTs
ENTRA_AUTH_ENABLED=false
ENTRA_TENANT_ID=""
ENTRA_API_CLIENT_ID=""
ENTRA_TOKEN_AUDIENCE=""
ENTRA_TOKEN_ISSUER=""
ENTRA_ALLOWED_CLIENT_APP_IDS=""

# Teacher/student credential management
ENTRA_TEACHER_CLIENT_ID=""
ENTRA_TEACHER_CLIENT_SECRET=""
STUDENT_SECRET_SALT=""

# LMS Gateway - memory avoids Cosmos-backed jobs for local tests
LMS_MOODLE_BASE_URL=""
LMS_MOODLE_TOKEN=""
LMS_CANVAS_BASE_URL=""
LMS_CANVAS_TOKEN=""
LMS_JOB_STORE="memory"

# Evaluation service - memory avoids Cosmos-backed runs for local tests
EVALUATION_REPOSITORY="memory"

# Learner-record integration
SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=""
SERVICE_BUS_LEARNER_RECORD_TOPIC="learner-record-events"
SERVICE_BUS_LEARNER_RECORD_SUBSCRIPTION="integration-backlog"

# Frontend/APIM route base used when this file is loaded for full-stack testing
NEXT_PUBLIC_APIM_BASE_URL=""