{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Service: avatar",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}\\apps\\avatar\\src",
      "python": "python",
      "envFile": "${workspaceFolder}\\.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\lib\\src;${workspaceFolder}\\apps\\avatar\\src"
      },
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8081"],
      "console": "integratedTerminal",
      "jinja": true,
      "justMyCode": false,
      "preLaunchTask": "env: verify"
    },
    {
      "name": "Service: configuration",
      "type": "debugpy",
      "request": "launch",
