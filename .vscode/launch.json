      "jinja": true,
      "justMyCode": false,
      "preLaunchTask": "env: verify"
    },
    {
      "name": "Frontend: Next dev",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "pnpm --dir frontend dev",
      "preLaunchTask": "env: verify"
    },
    {
      "name": "Attach: backend by port",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "127.0.0.1", "port": "${input:debugpyPort}" },
      "pathMappings": [{ "localRoot": "${workspaceFolder}", "remoteRoot": "${workspaceFolder}" }],
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "Debug: all backends",
      "configurations": [
        "Service: avatar",
        "Service: configuration",
        "Service: essays",
        "Service: questions",
        "Service: upskilling",
        "Service: chat",
        "Service: evaluation",
        "Service: lms-gateway",
        "Service: insights"
      ],
      "stopAll": true
    },
    {
      "name": "Debug: full stack",
      "configurations": [
        "Service: avatar",
        "Service: configuration",
        "Service: essays",
        "Service: questions",
        "Service: upskilling",
        "Service: chat",
        "Service: evaluation",
        "Service: lms-gateway",
        "Service: insights",
        "Frontend: Next dev"
      ],
      "stopAll": true
    },
    {
      "name": "Debug: frontend + chat",
      "configurations": ["Service: chat", "Frontend: Next dev"]
    },
    {
      "name": "Debug: frontend + evaluation",
      "configurations": ["Service: evaluation", "Frontend: Next dev"]
    }
  ],
  "inputs": [
    {
      "id": "debugpyPort",
      "type": "pickString",
      "description": "Backend debugpy port: avatar 5681, configuration 5682, essays 5683, questions 5684, upskilling 5685, chat 5686, evaluation 5687, lms-gateway 5688, insights 5689",
      "options": ["5681", "5682", "5683", "5684", "5685", "5686", "5687", "5688", "5689"],
      "default": "5686"
    }
  ]
}
